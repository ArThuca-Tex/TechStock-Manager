# As configurações do sistema continuam no ambiente do processo. A MEDUSA lê suas variáveis do .env.
DB_ENGINE=sqlite
# SQLITE_PATH=C:\caminho\techstock.db
# Usados somente com DB_ENGINE=sqlserver:
DB_SERVER=.\SQLEXPRESS
DB_NAME=db_techstock
DB_DRIVER=ODBC Driver 18 for SQL Server
SECRET_KEY=substitua-por-uma-chave-longa-aleatoria-e-estavel
COOKIE_SECURE=0
FLASK_DEBUG=0

# MEDUSA AI: copie apenas as duas linhas abaixo para .env. Sem chave, use o modo offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
