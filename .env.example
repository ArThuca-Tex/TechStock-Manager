# Referência: definir no ambiente do processo (não há carregamento automático).
DB_ENGINE=sqlite
# SQLITE_PATH=C:\caminho\techstock.db
# Usados somente com DB_ENGINE=sqlserver:
DB_SERVER=.\SQLEXPRESS
DB_NAME=db_techstock
DB_DRIVER=ODBC Driver 18 for SQL Server
SECRET_KEY=substitua-por-uma-chave-longa-aleatoria-e-estavel
COOKIE_SECURE=0
FLASK_DEBUG=0
